{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gitcty/swdeliveryagent/workflow/task.schema.json",
  "title": "Software delivery task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "owner", "iteration", "requirements", "artifacts", "checks", "notes", "history"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["intake", "requirements_ready", "implementation", "testing", "review", "blocked", "done"]},
    "owner": {"enum": ["orchestrator", "requirements", "developer", "tester", "reviewer"]},
    "iteration": {"type": "integer", "minimum": 1},
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "acceptance_criteria"],
      "properties": {
        "summary": {"type": "string"},
        "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["pending", "passed", "failed"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "actor", "from", "to", "summary"],
        "properties": {
          "at": {"type": "string", "format": "date-time"},
          "actor": {"enum": ["orchestrator", "requirements", "developer", "tester", "reviewer", "human"]},
          "from": {"type": ["string", "null"]},
          "to": {"type": "string"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
